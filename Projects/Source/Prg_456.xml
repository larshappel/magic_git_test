        <SQL_FORM DB="MySQL Database" RESTAB="Memory">
          <SQL_STMT_U val="WITH&#xD;&#xA;params AS (&#xD;&#xA;  SELECT&#xD;&#xA;    ':1' AS base_date,&#xD;&#xA;    DATE_SUB(':1', INTERVAL DAY(':1') - 1 DAY) AS month_start&#xD;&#xA;),&#xD;&#xA;customers_base AS (&#xD;&#xA;  SELECT&#xD;&#xA;    c.id AS customer_id,&#xD;&#xA;    c.name AS customer_name,&#xD;&#xA;    c.management_type,&#xD;&#xA;    COALESCE(NULLIF(c.billing_customer_id, 0), c.id) AS bill_to_customer_id,&#xD;&#xA;    c.closing_day1,&#xD;&#xA;    c.closing_day2,&#xD;&#xA;    c.closing_day3,&#xD;&#xA;    p.base_date,&#xD;&#xA;    p.month_start,&#xD;&#xA;    DATE_SUB(p.month_start, INTERVAL 1 MONTH) AS prev_month_start,&#xD;&#xA;    DAY(LAST_DAY(p.base_date)) AS last_day_current,&#xD;&#xA;    DAY(LAST_DAY(DATE_SUB(p.month_start, INTERVAL 1 MONTH))) AS last_day_prev&#xD;&#xA;  FROM customer c&#xD;&#xA;  CROSS JOIN params p&#xD;&#xA;  WHERE c.id BETWEEN :2 AND :3&#xD;&#xA;    AND (&#xD;&#xA;      :4 = 0&#xD;&#xA;      OR (:4 = 1 AND c.management_type = 1)&#xD;&#xA;      OR (:4 = 2 AND c.management_type = 2)&#xD;&#xA;      OR (:4 = 3 AND c.management_type = 3)&#xD;&#xA;      OR (:4 = 4 AND c.management_type IN (2,3))&#xD;&#xA;    )&#xD;&#xA;),&#xD;&#xA;customers AS (&#xD;&#xA;  SELECT&#xD;&#xA;    b.*,&#xD;&#xA;    CASE WHEN b.closing_day1 = 99 THEN b.last_day_current&#xD;&#xA;         WHEN b.closing_day1 BETWEEN 1 AND 31 THEN b.closing_day1 END AS cd1_cur,&#xD;&#xA;    CASE WHEN b.closing_day2 = 99 THEN b.last_day_current&#xD;&#xA;         WHEN b.closing_day2 BETWEEN 1 AND 31 THEN b.closing_day2 END AS cd2_cur,&#xD;&#xA;    CASE WHEN b.closing_day3 = 99 THEN b.last_day_current&#xD;&#xA;         WHEN b.closing_day3 BETWEEN 1 AND 31 THEN b.closing_day3 END AS cd3_cur,&#xD;&#xA;&#xD;&#xA;    CASE WHEN b.closing_day1 = 99 THEN b.last_day_prev&#xD;&#xA;         WHEN b.closing_day1 BETWEEN 1 AND 31 THEN b.closing_day1 END AS cd1_prev,&#xD;&#xA;    CASE WHEN b.closing_day2 = 99 THEN b.last_day_prev&#xD;&#xA;         WHEN b.closing_day2 BETWEEN 1 AND 31 THEN b.closing_day2 END AS cd2_prev,&#xD;&#xA;    CASE WHEN b.closing_day3 = 99 THEN b.last_day_prev&#xD;&#xA;         WHEN b.closing_day3 BETWEEN 1 AND 31 THEN b.closing_day3 END AS cd3_prev&#xD;&#xA;  FROM customers_base b&#xD;&#xA;),&#xD;&#xA;customers_final AS (&#xD;&#xA;  SELECT&#xD;&#xA;    c.*,&#xD;&#xA;    GREATEST(&#xD;&#xA;      IF(c.cd1_cur IS NOT NULL AND c.cd1_cur &lt;= DAY(c.base_date), c.cd1_cur, 0),&#xD;&#xA;      IF(c.cd2_cur IS NOT NULL AND c.cd2_cur &lt;= DAY(c.base_date), c.cd2_cur, 0),&#xD;&#xA;      IF(c.cd3_cur IS NOT NULL AND c.cd3_cur &lt;= DAY(c.base_date), c.cd3_cur, 0)&#xD;&#xA;    ) AS last_close_day_cur,&#xD;&#xA;    GREATEST(&#xD;&#xA;      IF(c.cd1_prev IS NOT NULL, c.cd1_prev, 0),&#xD;&#xA;      IF(c.cd2_prev IS NOT NULL, c.cd2_prev, 0),&#xD;&#xA;      IF(c.cd3_prev IS NOT NULL, c.cd3_prev, 0)&#xD;&#xA;    ) AS last_close_day_prev&#xD;&#xA;  FROM customers c&#xD;&#xA;),&#xD;&#xA;customers_period AS (&#xD;&#xA;  SELECT&#xD;&#xA;    c.*,&#xD;&#xA;    CASE&#xD;&#xA;      WHEN c.cd1_cur IS NULL AND c.cd2_cur IS NULL AND c.cd3_cur IS NULL THEN c.month_start&#xD;&#xA;      WHEN c.last_close_day_cur > 0 THEN DATE_ADD(c.month_start, INTERVAL c.last_close_day_cur - 1 DAY)&#xD;&#xA;      ELSE DATE_ADD(c.prev_month_start, INTERVAL LEAST(c.last_close_day_prev, c.last_day_prev) - 1 DAY)&#xD;&#xA;    END AS last_closing_date&#xD;&#xA;  FROM customers_final c&#xD;&#xA;),&#xD;&#xA;customers_period2 AS (&#xD;&#xA;  SELECT&#xD;&#xA;    c.*,&#xD;&#xA;    DATE_ADD(c.last_closing_date, INTERVAL 1 DAY) AS period_start&#xD;&#xA;  FROM customers_period c&#xD;&#xA;),&#xD;&#xA;prev_balance AS (&#xD;&#xA;  SELECT rf.customer_id, rf.current_balance AS previous_balance&#xD;&#xA;  FROM receivables_file rf&#xD;&#xA;  JOIN (&#xD;&#xA;    SELECT&#xD;&#xA;      customer_id,&#xD;&#xA;      MAX(`year_month`) AS max_year_month&#xD;&#xA;    FROM receivables_file&#xD;&#xA;    JOIN params p&#xD;&#xA;      ON `year_month` &lt; p.month_start&#xD;&#xA;    GROUP BY customer_id&#xD;&#xA;  ) x&#xD;&#xA;    ON x.customer_id = rf.customer_id&#xD;&#xA;   AND x.max_year_month = rf.`year_month`&#xD;&#xA;),&#xD;&#xA;sales AS (&#xD;&#xA;  SELECT&#xD;&#xA;    s.billing_customer_id AS customer_id,&#xD;&#xA;    SUM(COALESCE(s.standard_sales_amount,0) + COALESCE(s.reduced_sales_amount,0)) AS sales_amount,&#xD;&#xA;    SUM(COALESCE(s.standard_return_amount,0) + COALESCE(s.reduced_return_amount,0)) AS return_amount,&#xD;&#xA;    SUM(COALESCE(s.standard_discount_amount,0) + COALESCE(s.reduced_discount_amount,0)) AS discount_amount,&#xD;&#xA;    SUM(COALESCE(s.standard_tax,0) + COALESCE(s.reduced_tax,0)) AS tax_amount&#xD;&#xA;  FROM sale s&#xD;&#xA;  JOIN customers_period2 c&#xD;&#xA;    ON c.bill_to_customer_id = s.billing_customer_id&#xD;&#xA;  WHERE s.sales_date >= c.period_start&#xD;&#xA;    AND s.sales_date &lt;= ':1'&#xD;&#xA;  GROUP BY s.billing_customer_id&#xD;&#xA;),&#xD;&#xA;payments AS (&#xD;&#xA;  SELECT&#xD;&#xA;    r.billing_customer_id AS customer_id,&#xD;&#xA;    SUM(COALESCE(r.amount,0) + COALESCE(r.fee,0)) AS payment_amount&#xD;&#xA;  FROM receipt r&#xD;&#xA;  JOIN customers_period2 c&#xD;&#xA;    ON c.bill_to_customer_id = r.billing_customer_id&#xD;&#xA;  WHERE r.receipt_date >= c.period_start&#xD;&#xA;    AND r.receipt_date &lt;= ':1'&#xD;&#xA;  GROUP BY r.billing_customer_id&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;  c.customer_id AS 得意先CD,&#xD;&#xA;  c.customer_name AS 得意先名,&#xD;&#xA;  COALESCE(pb.previous_balance,0) AS 前月残高,&#xD;&#xA;  COALESCE(s.sales_amount,0)      AS 売上金額,&#xD;&#xA;  COALESCE(s.return_amount,0)     AS 返品金額,&#xD;&#xA;  COALESCE(s.discount_amount,0)   AS 値引金額,&#xD;&#xA;  COALESCE(s.tax_amount,0)        AS 消費税額,&#xD;&#xA;  COALESCE(p.payment_amount,0)    AS 入金金額,&#xD;&#xA;  (&#xD;&#xA;    COALESCE(pb.previous_balance,0)&#xD;&#xA;    + COALESCE(s.sales_amount,0)&#xD;&#xA;    + COALESCE(s.return_amount,0)&#xD;&#xA;    + COALESCE(s.discount_amount,0)&#xD;&#xA;    + COALESCE(s.tax_amount,0)&#xD;&#xA;    - COALESCE(p.payment_amount,0)&#xD;&#xA;  ) AS 当月残高&#xD;&#xA;FROM customers_period2 c&#xD;&#xA;LEFT JOIN prev_balance pb ON pb.customer_id = c.customer_id&#xD;&#xA;LEFT JOIN sales s         ON s.customer_id  = c.bill_to_customer_id&#xD;&#xA;LEFT JOIN payments p      ON p.customer_id  = c.bill_to_customer_id&#xD;&#xA;ORDER BY c.customer_id;"/>
