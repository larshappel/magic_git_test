        <SQL_FORM DB="MySQL Database" RESTAB="Memory">
          <SQL_STMT_U val="WITH RECURSIVE months AS (&#xA;  SELECT LAST_DAY(':1') AS ym&#xA;  UNION ALL&#xA;  SELECT LAST_DAY(DATE_ADD(ym, INTERVAL 1 MONTH))&#xA;  FROM months&#xA;  WHERE ym &lt; LAST_DAY(':2')&#xA;)&#xA;SELECT&#xA;  t.customer_id,&#xA;  t.customer_name,&#xA;  t.year_month,&#xA;  t.previous_balance,&#xA;  t.standard_sales_amount,&#xA;  t.standard_return_amount,&#xA;  t.standard_discount_amount,&#xA;  t.standard_tax_amount,&#xA;  t.reduced_sales_amount,&#xA;  t.reduced_return_amount,&#xA;  t.reduced_discount_amount,&#xA;  t.reduced_tax_amount,&#xA;  t.payment_amount,&#xA;  t.current_balance&#xA;FROM (&#xA;  SELECT&#xA;    c.id AS customer_id,&#xA;    c.name AS customer_name,&#xA;    m.ym AS `year_month`,&#xA;    c.branch_type AS branch_type,&#xA;    c.tax_category AS tax_category,&#xA;    c.tax_type AS tax_type,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.previous_balance, 0)&#xA;      ELSE IFNULL(pb.previous_balance, 0)&#xA;    END AS previous_balance,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.standard_sales_amount, 0)&#xA;      ELSE IFNULL(sm.standard_sales_amount, 0)&#xA;    END AS standard_sales_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.standard_return_amount, 0)&#xA;      ELSE IFNULL(sm.standard_return_amount, 0)&#xA;    END AS standard_return_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.standard_discount_amount, 0)&#xA;      ELSE IFNULL(sm.standard_discount_amount, 0)&#xA;    END AS standard_discount_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.standard_tax_amount, 0)&#xA;      ELSE IFNULL(sm.standard_tax_amount, 0)&#xA;    END AS standard_tax_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.reduced_sales_amount, 0)&#xA;      ELSE IFNULL(sm.reduced_sales_amount, 0)&#xA;    END AS reduced_sales_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.reduced_return_amount, 0)&#xA;      ELSE IFNULL(sm.reduced_return_amount, 0)&#xA;    END AS reduced_return_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.reduced_discount_amount, 0)&#xA;      ELSE IFNULL(sm.reduced_discount_amount, 0)&#xA;    END AS reduced_discount_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN 0&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.reduced_tax_amount, 0)&#xA;      ELSE IFNULL(sm.reduced_tax_amount, 0)&#xA;    END AS reduced_tax_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.payment_amount, 0)&#xA;      ELSE IFNULL(rm.payment_amount, 0)&#xA;    END AS payment_amount,&#xA;&#xA;    CASE&#xA;      WHEN IFNULL(c.branch_type, 0) = 1 THEN&#xA;        ( IFNULL(&#xA;            CASE&#xA;              WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.previous_balance, 0)&#xA;              ELSE IFNULL(pb.previous_balance, 0)&#xA;            END, 0)&#xA;        - IFNULL(&#xA;            CASE&#xA;              WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.payment_amount, 0)&#xA;              ELSE IFNULL(rm.payment_amount, 0)&#xA;            END, 0)&#xA;        )&#xA;      WHEN IFNULL(c.branch_type, 0) &lt;> 2 THEN IFNULL(rf.current_balance, 0)&#xA;      ELSE&#xA;        ( IFNULL(pb.previous_balance, 0)&#xA;        + ( IFNULL(sm.standard_sales_amount, 0)&#xA;          - IFNULL(sm.standard_return_amount, 0)&#xA;          - IFNULL(sm.standard_discount_amount, 0)&#xA;          + IF(&#xA;              IFNULL(c.tax_category,0)=2 AND IFNULL(c.tax_type,0)=2,&#xA;              0,&#xA;              IFNULL(sm.standard_tax_amount,0)&#xA;            )&#xA;          + IFNULL(sm.reduced_sales_amount, 0)&#xA;          - IFNULL(sm.reduced_return_amount, 0)&#xA;          - IFNULL(sm.reduced_discount_amount, 0)&#xA;          + IF(&#xA;              IFNULL(c.tax_category,0)=2 AND IFNULL(c.tax_type,0)=2,&#xA;              0,&#xA;              IFNULL(sm.reduced_tax_amount,0)&#xA;            )&#xA;          )&#xA;        - IFNULL(rm.payment_amount, 0)&#xA;        )&#xA;    END AS current_balance&#xA;&#xA;  FROM customer c&#xA;  CROSS JOIN months m&#xA;&#xA;  LEFT JOIN receivables_file rf&#xA;    ON rf.customer_id = c.id&#xA;   AND rf.year_month = m.ym&#xA;&#xA;  LEFT JOIN (&#xA;    SELECT&#xA;      CASE&#xA;        WHEN s.customer_id IS NOT NULL&#xA;         AND s.billing_customer_id IS NOT NULL&#xA;         AND s.customer_id &lt;> s.billing_customer_id&#xA;        THEN s.customer_id&#xA;        ELSE s.billing_customer_id&#xA;      END AS customer_id,&#xA;      LAST_DAY(s.sales_date) AS ym,&#xA;      SUM(IFNULL(s.standard_sales_amount, 0))    AS standard_sales_amount,&#xA;      SUM(IFNULL(s.standard_return_amount, 0))   AS standard_return_amount,&#xA;      SUM(IFNULL(s.standard_discount_amount, 0)) AS standard_discount_amount,&#xA;      SUM(IFNULL(s.standard_tax, 0))             AS standard_tax_amount,&#xA;      SUM(IFNULL(s.reduced_sales_amount, 0))     AS reduced_sales_amount,&#xA;      SUM(IFNULL(s.reduced_return_amount, 0))    AS reduced_return_amount,&#xA;      SUM(IFNULL(s.reduced_discount_amount, 0))  AS reduced_discount_amount,&#xA;      SUM(IFNULL(s.reduced_tax, 0))              AS reduced_tax_amount&#xA;    FROM sale s&#xA;    WHERE s.sales_date >= DATE_FORMAT(':1', '%Y-%m-01')&#xA;      AND s.sales_date &lt;= LAST_DAY(':2')&#xA;      AND IFNULL(s.delete_flag, 0) = 0&#xA;    GROUP BY&#xA;      CASE&#xA;        WHEN s.customer_id IS NOT NULL&#xA;         AND s.billing_customer_id IS NOT NULL&#xA;         AND s.customer_id &lt;> s.billing_customer_id&#xA;        THEN s.customer_id&#xA;        ELSE s.billing_customer_id&#xA;      END,&#xA;      LAST_DAY(s.sales_date)&#xA;  ) sm&#xA;    ON sm.customer_id = c.id&#xA;   AND sm.ym = m.ym&#xA;&#xA;  LEFT JOIN (&#xA;    SELECT&#xA;      r.billing_customer_id AS customer_id,&#xA;      LAST_DAY(r.receipt_date) AS ym,&#xA;      SUM(IFNULL(r.amount, 0)) AS payment_amount&#xA;    FROM receipt r&#xA;    WHERE r.receipt_date >= DATE_FORMAT(':1', '%Y-%m-01')&#xA;      AND r.receipt_date &lt;= LAST_DAY(':2')&#xA;      AND IFNULL(r.delete_flag, 0) = 0&#xA;    GROUP BY r.billing_customer_id, LAST_DAY(r.receipt_date)&#xA;  ) rm&#xA;    ON rm.customer_id = c.id&#xA;   AND rm.ym = m.ym&#xA;&#xA;  LEFT JOIN (&#xA;    SELECT&#xA;      x.customer_id,&#xA;      x.ym,&#xA;      SUM(x.sales_net) - SUM(x.payment_amount) AS previous_balance&#xA;    FROM (&#xA;      SELECT&#xA;        CASE&#xA;          WHEN s.customer_id IS NOT NULL&#xA;           AND s.billing_customer_id IS NOT NULL&#xA;           AND s.customer_id &lt;> s.billing_customer_id&#xA;          THEN s.customer_id&#xA;          ELSE s.billing_customer_id&#xA;        END AS customer_id,&#xA;        LAST_DAY(DATE_SUB(s.sales_date, INTERVAL 1 DAY)) AS ym,&#xA;        ( IFNULL(s.standard_sales_amount, 0)&#xA;        - IFNULL(s.standard_return_amount, 0)&#xA;        - IFNULL(s.standard_discount_amount, 0)&#xA;        + IFNULL(s.standard_tax, 0)&#xA;        + IFNULL(s.reduced_sales_amount, 0)&#xA;        - IFNULL(s.reduced_return_amount, 0)&#xA;        - IFNULL(s.reduced_discount_amount, 0)&#xA;        + IFNULL(s.reduced_tax, 0)&#xA;        ) AS sales_net,&#xA;        0 AS payment_amount&#xA;      FROM sale s&#xA;      WHERE s.sales_date &lt; DATE_FORMAT(':1', '%Y-%m-01')&#xA;        AND IFNULL(s.delete_flag, 0) = 0&#xA;&#xA;      UNION ALL&#xA;&#xA;      SELECT&#xA;        r.billing_customer_id AS customer_id,&#xA;        LAST_DAY(DATE_SUB(r.receipt_date, INTERVAL 1 DAY)) AS ym,&#xA;        0 AS sales_net,&#xA;        IFNULL(r.amount, 0) AS payment_amount&#xA;      FROM receipt r&#xA;      WHERE r.receipt_date &lt; DATE_FORMAT(':1', '%Y-%m-01')&#xA;        AND IFNULL(r.delete_flag, 0) = 0&#xA;    ) x&#xA;    GROUP BY x.customer_id, x.ym&#xA;  ) pb&#xA;    ON pb.customer_id = c.id&#xA;   AND pb.ym = m.ym&#xA;&#xA;  WHERE c.id BETWEEN :3 AND :4&#xA;    AND m.ym BETWEEN LAST_DAY(':1') AND LAST_DAY(':2')&#xA;) t&#xA;WHERE&#xA;  (&#xA;    t.branch_type = 1&#xA;    AND (&#xA;      EXISTS (&#xA;        SELECT 1&#xA;        FROM sale s2&#xA;        WHERE s2.billing_customer_id = t.customer_id&#xA;          AND s2.sales_date >= DATE_FORMAT(':1', '%Y-%m-01')&#xA;          AND s2.sales_date &lt;= LAST_DAY(':2')&#xA;          AND IFNULL(s2.delete_flag, 0) = 0&#xA;      )&#xA;      OR EXISTS (&#xA;        SELECT 1&#xA;        FROM receipt r2&#xA;        WHERE r2.billing_customer_id = t.customer_id&#xA;          AND r2.receipt_date >= DATE_FORMAT(':1', '%Y-%m-01')&#xA;          AND r2.receipt_date &lt;= LAST_DAY(':2')&#xA;          AND IFNULL(r2.delete_flag, 0) = 0&#xA;      )&#xA;    )&#xA;  )&#xA;  OR t.previous_balance        &lt;> 0&#xA;  OR t.standard_sales_amount   &lt;> 0&#xA;  OR t.standard_return_amount  &lt;> 0&#xA;  OR t.standard_discount_amount&lt;> 0&#xA;  OR t.standard_tax_amount     &lt;> 0&#xA;  OR t.reduced_sales_amount    &lt;> 0&#xA;  OR t.reduced_return_amount   &lt;> 0&#xA;  OR t.reduced_discount_amount &lt;> 0&#xA;  OR t.reduced_tax_amount      &lt;> 0&#xA;  OR t.payment_amount          &lt;> 0&#xA;  OR t.current_balance         &lt;> 0&#xA;ORDER BY t.customer_id, t.year_month;"/>
